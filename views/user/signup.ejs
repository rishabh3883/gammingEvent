<% layout('layouts/boilerplates') %> 

     <div class="wrap neon-outline">
        <form action="/signup" method="POST" novalidate class="needs-validation">
            <label for="username" 
            class="form-label"><b>Username </b><br></label>
               <input name ="username" 
                    type ="text" 
                    class="form-control"
                    id="username"
                    required
                />
                <br>
                <label for="email" 
                class="form-label"><b>Email </b> <br></label>
                <input name ="email" 
                type ="email" 
                class="form-control"
                id="email"
                required
                />
                <br>
                <label for="password" 
                class="form-label"><b>Password </b> <br></label>
                <input name ="password" 
                    type ="password" 
                    class="form-control"
                    id="password"
                    required
                />
                
            
            <div class="cta wrap neon-outline">
          <button class="btn btn-primary">signup</button>
            </div>

         </div> 

