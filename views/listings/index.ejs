<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Gaming Event Organizer - Mockup</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
   <link 
      rel="stylesheet" 
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    
    <link rel="stylesheet" href="/css/navbar.css"> 
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/events.css">
    <link rel="stylesheet" href="/css/style.css">
  </head>


  <style>
    :root{
      --bg:#0f0f12;
      --card:#121217cc;
      --accent:#ff4757;
      --accent-2:#715aff;
      --muted:#bfbfbf;
      --glass: rgba(255,255,255,0.04);
    }
    *{box-sizing:border-box}
    
    /* === YAHAN CHANGE KIYA GAYA HAI === */
    html,body{
      height:100%;
      margin:0;
      font-family:Poppins,system-ui,Arial;
      background:linear-gradient(180deg,#07070a 0%, #0f0f12 100%);
      color:#fff;

      /* Sticky Footer ke liye yeh 3 lines add ki gayi hain */
      display: flex;
      flex-direction: column;
      min-height: 100vh; 
    }
    /* === END CHANGE === */


    /* Container */
    .wrap{max-width:1100px;margin:32px auto;padding:28px;border-radius:18px;background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));box-shadow:0 10px 40px rgba(0,0,0,0.6);border:1px solid rgba(255,255,255,0.03)}

    /* Top nav */
    .nav{display:flex;align-items:center;justify-content:space-between;padding:6px 12px}
    .nav a:hover{color: #8a2be2; }
    .brand{display:flex;align-items:center;gap:12px}
    .logo{width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:flex;align-items:center;justify-content:center;font-family:Orbitron;font-weight:700}
    .logo span{transform:translateY(-1px)}
    .nav-links{display:flex;gap:20px;align-items:center}
    .nav-links a{color:var(--muted);text-decoration:none;font-weight:600}
    .btn-login{padding:8px 14px;border-radius:10px;border:1px solid rgba(255,255,255,0.06);background:transparent;color:#fff}

    /* Hero */
    .hero{display:grid;grid-template-columns:1fr;gap:24px;align-items:center;padding:28px 12px}
    .hero-inner{display:flex;flex-direction:column;gap:18px}
    .hero h1{font-family:Orbitron;font-size:48px;letter-spacing:1px;margin:0;line-height:1}
    .hero p{color:var(--muted);margin:0;max-width:760px}
    .cta{display:flex;gap:16px}
    .btn{padding:14px 26px;border-radius:12px;font-weight:700;border:2px solid transparent;cursor:pointer}
    .btn-primary{background:linear-gradient(90deg,var(--accent),var(--accent-2));box-shadow:0 8px 30px rgba(113,90,255,0.12);color:#fff}
    .btn-outline{background:transparent;border:2px solid rgba(255,71,87,0.14);color:#fff}

    /* Cards row */
    .section-title{font-family:Orbitron;font-size:20px;margin:20px 0 12px}
    .cards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
    .card{background:linear-gradient(180deg,var(--card), rgba(255,255,255,0.02));padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,0.03);backdrop-filter:blur(6px);position:relative;overflow:hidden}
    .card .thumb{height:140px;border-radius:8px;background:linear-gradient(180deg,rgba(0,0,0,0.3),rgba(0,0,0,0.6));display:flex;align-items:end;padding:12px}
    .card h4{margin:10px 0 4px;font-size:18px}
    .meta{color:var(--muted);font-size:13px}
    .card .pill{position:absolute;top:12px;right:12px;padding:6px 8px;border-radius:8px;background:linear-gradient(90deg,var(--accent),var(--accent-2));font-weight:700;font-size:12px}

    /* Featured games */
    .featured{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
    .game-box{min-width:180px;border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.03);text-align:center;background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.01));}

    /* Footer / testimonial */
    .testimonial{display:flex;gap:20px;align-items:center;margin-top:18px}
    .testimonial p{color:var(--muted);max-width:720px}
    .avatar{width:140px;height:100px;border-radius:8px;background:linear-gradient(135deg,#2b2b39,#1a1321)}

    /* small screens */
    @media (max-width:900px){.cards{grid-template-columns:repeat(2,1fr)}.hero h1{font-size:36px}.wrap{margin:16px}}
    @media (max-width:560px){.cards{grid-template-columns:1fr}.nav-links{display:none}.hero h1{font-size:28px}.cta{flex-direction:column;align-items:flex-start}}

    /* subtle neon outlines */
    .neon-outline{box-shadow:0 0 20px rgba(255,71,87,0.06), inset 0 0 40px rgba(113,90,255,0.02)}
    
    .join-btn1:hover {
  transform: scale(1.05);
  box-shadow: 0 0 18px rgba(255, 0, 200, 0.7);
}


  </style>
</head>
<body>
  
  <div class="wrap neon-outline">
    
     <nav class="nav btn-login join-btn">
      <div class="brand btn-login join-btn">
        <div class="logo "><a href="/"><span>G</span></a></div>
        <div><a href="/">
          <div style="font-weight:700 ">GAMING</div>
          <div style="font-size:12px;color:var(--muted)">For Gammers</div>
          </a>
        </div>
      </div>
      <div class="nav-links">
        <a class=" btn-login join-btn" href="/events">Events</a>
         <a class=" btn-login join-btn" href="/leaderboard">Leaderboard</a>
        <a class="btn-login join-btn" href="/signup">Signup</a>
        <a class="btn-login join-btn" href="/login">Login</a>
      </div>
    </nav>

    <hr>

    <header class="hero">
      <div class="hero-inner">
        <h1 class=" btn-login join-btn"> Create & Join Tournaments<br/> Gaming  Events</h1>
        <p>Grow a community of competitive players. Clean, mobile-friendly UI with neon accents and glass panels designed for gamers.</p>
        <div class="cta"><a href="/events">
          <button class="btn join-btn">Join Tournament</button>
          </a></div>
      </div>
      
      </header>
    
    </div> 

   
   
  <footer class="site-footer btn-login">
      <div class="footer-container">
          <div class="footer-social">
              <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f btn-login join-btn"></i></a>
              <a href="#" aria-label="Instagram"><i class="fab fa-instagram btn-login join-btn"></i></a>
              <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in btn-login join-btn"></i></a>
              <a href="#" aria-label="YouTube"><i class="fab fa-youtube btn-login join-btn"></i></a>
          </div>

          <div class="footer-links">
              <a class="btn-login join-btn" href="/privacy">Privacy Policy</a>
              <a class="btn-login join-btn" href="/terms">Terms of Service</a>
          </div>

          <div class="footer-copyright">
              &copy; <%= new Date().getFullYear() %> GAMING. All Rights Reserved.
          </div>
      </div>
  </footer>

   <script>
    // Add little hover neon effect
    document.querySelectorAll('.card').forEach(c=>{
      c.addEventListener('mouseenter',()=>c.style.boxShadow='0 12px 40px rgba(113,90,255,0.12), 0 0 30px rgba(255,71,87,0.04)');
      c.addEventListener('mouseleave',()=>c.style.boxShadow='none');
    })
  </script>
</body>
</html>